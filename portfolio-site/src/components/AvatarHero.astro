---
interface Props {
	modelSrc: string;
	idleAnimationSrc?: string;
}

const { modelSrc, idleAnimationSrc } = Astro.props;
---

<div class="avatar-hero" data-model-src={modelSrc} data-idle-animation-src={idleAnimationSrc}>
	<img
		class="avatar-fallback"
		alt="Matthew Aisthorpe"
		width="480"
		height="620"
		src="/assets/portrait.jpg"
		fetchpriority="high"
	/>
	<canvas class="avatar-canvas" aria-hidden="true"></canvas>
</div>

<script>
	import { initVrmAvatar } from "../scripts/avatar/vrmAvatar";

	document.querySelectorAll<HTMLElement>(".avatar-hero:not([data-avatar-initialized])").forEach((root) => {
		root.dataset.avatarInitialized = "";
		initVrmAvatar(root);
	});
</script>

<style>
	.avatar-hero {
		position: relative;
		z-index: 1;
		width: min(100%, 22rem);
		aspect-ratio: 3 / 4;
		isolation: isolate;
	}

	.avatar-fallback,
	.avatar-canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		transition: opacity 400ms ease;
	}

	.avatar-fallback {
		z-index: 1;
		object-fit: cover;
		object-position: top;
		filter: saturate(1.04) contrast(1.03);
	}

	.avatar-canvas {
		z-index: 2;
		opacity: 0;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 68%,
			rgba(0, 0, 0, 0.72) 80%,
			rgba(0, 0, 0, 0.2) 92%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 68%,
			rgba(0, 0, 0, 0.72) 80%,
			rgba(0, 0, 0, 0.2) 92%,
			transparent 100%
		);
	}

	.avatar-hero[data-avatar-ready] .avatar-fallback {
		opacity: 0;
	}

	.avatar-hero[data-avatar-ready] .avatar-canvas {
		opacity: 1;
	}

	@media (min-width: 50em) {
		.avatar-hero {
			width: min(100%, 32rem);
			height: clamp(32rem, 38vw, 38rem);
			aspect-ratio: auto;
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.avatar-fallback,
		.avatar-canvas {
			transition: none;
		}
	}
</style>
