---
interface Props {
	slot?: string;
}

const { slot = "1165458144" } = Astro.props;
---

<div class="adsense-placement">
	<ins
		class="adsbygoogle"
		style="display:block"
		data-ad-client="ca-pub-2573721355823332"
		data-ad-slot={slot}
		data-ad-format="auto"
		data-full-width-responsive="true"
	></ins>
</div>

<script is:inline>
	window.initializeAdSense?.();
</script>
