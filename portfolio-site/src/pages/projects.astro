---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import CallToAction from "../components/CallToAction.astro";
import Icon from "../components/Icon.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";
import Pill from "../components/Pill.astro";
import {
	getProjectCategorySlugs,
	projectCategories,
} from "../utils/projectCategories";

const projects = (await getCollection("projects")).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const totalCount = projects.length;
const categoriesByProject = new Map(
	projects.map((project) => [project.id, getProjectCategorySlugs(project)]),
);
const categoryCounts = new Map(
	projectCategories.map((category) => [
		category.slug,
		projects.filter((project) =>
			categoriesByProject.get(project.id)?.includes(category.slug),
		).length,
	]),
);
---

<BaseLayout
	title="Technical Projects | Matthew Aisthorpe"
	description="Selected technical projects by Matthew Aisthorpe across AI-enabled platforms, XR experiences, modern web systems, apps, and software delivery."
	url="https://matthewaisthorpe.com.au/projects/"
>
	<div class="stack gap-20">

		<main class="wrapper stack gap-8">
			<CallToAction href="https://www.linkedin.com/in/matthewaisthorpe/">
				<p>View My <span class="max-lg:hidden">Professional Journey on</span> LinkedIn</p>
				<Icon icon="arrow-right" size="1.2em" />
			</CallToAction>

			<Hero
				title="Selected Projects"
				tagline="Selected work across AI, XR, software platforms and emerging technology."
			/>

			<div class="tag-filter" data-filter-group>
				<button class="tag-pill is-active" type="button" data-category="all">
					<Pill>All · {totalCount}</Pill>
				</button>
				{
					projectCategories.map((category) => (
						<button
							class="tag-pill"
							type="button"
							data-category={category.slug}
						>
							<Pill>
								{category.label} · {categoryCounts.get(category.slug) ?? 0}
							</Pill>
						</button>
					))
				}
			</div>

			<Grid variant="offset" class="project-grid" id="projectGrid">
				{
					projects.map((project) => (
						<li
							class="project-card"
							data-project-card
							data-categories={categoriesByProject
								.get(project.id)
								?.join("|")}
						>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<script type="module" is:inline>
	const grid = document.getElementById("projectGrid");
	const buttons = Array.from(
		document.querySelectorAll(".tag-pill"),
	);
	const cards = Array.from(
		document.querySelectorAll("[data-project-card]"),
	);

	const setActive = (category) => {
		buttons.forEach((button) => {
			button.classList.toggle("is-active", button.dataset.category === category);
		});
	};

	const applyFilter = (category) => {
		if (!grid) return;
		setActive(category);

		const before = new Map(
			cards.map((card) => [card, card.getBoundingClientRect()]),
		);

		cards.forEach((card) => {
			const categories = card.dataset.categories?.split("|") ?? [];
			const isMatch = category === "all" || categories.includes(category);
			card.dataset.match = isMatch ? "true" : "false";
			card.classList.toggle("is-dimmed", !isMatch);
		});

		const matched = cards.filter((card) => card.dataset.match === "true");
		const rest = cards.filter((card) => card.dataset.match !== "true");
		[...matched, ...rest].forEach((card) => grid.appendChild(card));

		const after = new Map(
			cards.map((card) => [card, card.getBoundingClientRect()]),
		);

		cards.forEach((card) => {
			const first = before.get(card);
			const last = after.get(card);
			if (!first || !last) return;
			const dx = first.left - last.left;
			const dy = first.top - last.top;
			if (!dx && !dy) return;
			card.animate(
				[
					{ transform: `translate(${dx}px, ${dy}px)` },
					{ transform: "translate(0, 0)" },
				],
				{ duration: 380, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
			);
		});
	};

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			applyFilter(button.dataset.category || "all");
		});
	});
</script>

<style>
	.tag-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.tag-pill {
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
		transition: transform var(--theme-transition),
			filter var(--theme-transition);
	}

	.tag-pill :global(.pill) {
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition),
			background var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	.tag-pill.is-active {
		transform: translateY(-2px);
	}

	.tag-pill.is-active :global(.pill) {
		color: var(--accent-text-over);
		border-color: transparent;
		background: var(--gradient-accent);
		box-shadow: 0 12px 28px var(--accent-overlay);
	}

	.tag-pill:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 4px;
		border-radius: 999rem;
	}

	.project-grid {
		margin: 0;
	}

	.project-card {
		transition: opacity var(--theme-transition),
			transform var(--theme-transition);
	}

	.project-card.is-dimmed {
		opacity: 0.3;
	}

</style>
