---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import CallToAction from "../components/CallToAction.astro";
import Icon from "../components/Icon.astro";
import Hero from "../components/Hero.astro";

const pageTitle = "About | Matthew Aisthorpe";
const pageDescription =
	"About Matthew Aisthorpe, a Brisbane-based product and delivery leader working across AI adoption, XR, solution architecture, software delivery, and digital transformation.";
const pageUrl = "https://matthewaisthorpe.com.au/about/";
const personId = `${pageUrl}#person`;
const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": `${pageUrl}#profile-page`,
	name: pageTitle,
	description: pageDescription,
	url: pageUrl,
	mainEntity: {
		"@type": "Person",
		"@id": personId,
		name: "Matthew Aisthorpe",
		url: pageUrl,
		image: "https://matthewaisthorpe.com.au/assets/portrait.jpg",
		jobTitle: "Head of XR, Web & AI Development",
		description:
			"Brisbane-based product and delivery leader working across AI adoption, XR, solution architecture, software delivery, and digital transformation.",
		address: {
			"@type": "PostalAddress",
			addressLocality: "Brisbane",
			addressRegion: "Queensland",
			addressCountry: "Australia",
		},
		sameAs: [
			"https://www.linkedin.com/in/matthewaisthorpe/",
			"https://github.com/beardydevadventures",
			"https://www.youtube.com/@beardydevadventures",
			"https://www.credly.com/users/matthew-aisthorpe",
			"https://devpost.com/MatthewAisthorpe",
		],
		knowsAbout: [
			"Technical Delivery",
			"Solution Architecture",
			"AI Adoption and Enablement",
			"XR",
			"Spatial Computing",
			"Software Delivery",
			"Digital Transformation",
		],
	},
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	url={pageUrl}
	type="profile"
	schema={profileSchema}
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About Me"
				tagline="From software engineering to product and delivery leadership across AI, XR, and digital platforms."
			>
				<img
					class="hero-image"
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Matthew Aisthorpe standing in a room looking professional and welcoming."
				/>
			</Hero>

			<div class="about-grid">
				<div class="main">
					<section class="card info-section lead-section">
						<h2 class="section-title">What I lead now</h2>
						<div class="content">
							<p>I'm Matthew, a Brisbane-based product and delivery leader with a background in software development. I've worked across education, retail and emerging technology.</p>
							<p>As Head of XR, Web &amp; AI Development at 3D Walkabout, I lead a multidisciplinary team of eight. I manage project budgets, team costs and resource allocation across concurrent client projects.</p>
							<p>My responsibilities include recruitment, performance reviews and team development. I work with clients and the team to shape scope and make delivery trade-offs, while staying involved in architecture and technical direction.</p>
							<p><a href="/projects/leadership/leading-xr-web-ai-delivery/">Read about leading people, priorities and delivery at 3D Walkabout</a>.</p>
						</div>
					</section>

					<section class="card info-section">
						<h2 class="section-title">How I lead</h2>
						<div class="content">
							<ul>
								<li><strong>People:</strong> I support the team through recruitment, feedback and development, and match work to the capacity we have.</li>
								<li><strong>Priorities:</strong> I work with clients and stakeholders to shape scope, understand constraints and make trade-offs around what we deliver.</li>
								<li><strong>Delivery:</strong> I keep budgets, technical decisions and progress in view, with clear communication about what the team is working towards.</li>
							</ul>
						</div>
					</section>

					<section class="card info-section">
						<h2 class="section-title">Selected work from my career</h2>
						<div class="content">
							<p>My career has moved from hands-on software engineering into product ownership, project leadership and responsibility for people and delivery. These are a few examples of that work.</p>
							<ul>
								<li><strong>AI adoption at CQUniversity:</strong> I led university-wide AI adoption through the Digital Services AI Taskforce, overseeing security assessments of AI tools and developing responsible AI use guidelines. Our taskforce provided a portal of tools approved for specific tasks, including generating emails, images and videos, to help staff navigate the choices. <a href="/projects/leadership/leading-practical-ai-adoption/">Read the AI adoption case study</a>.</li>
								<li><strong>Enterprise platforms at CQUniversity:</strong> As a Project Leader, I led work to migrate legacy on-premise systems to cloud platforms across multiple directorates.</li>
								<li><strong>StaffNet at CQUniversity:</strong> I led the StaffNet redesign and migration from SharePoint 2013 to SharePoint Online. Homepage visits increased by 126% in the three months after launch compared with the three months before launch.</li>
								<li><strong>Product ownership at EB Games:</strong> I led delivery of an Uber-integrated checkout and fulfilment platform with real-time delivery tracking.</li>
							</ul>
							<div class="cta-row start cta-small">
								<CallToAction href="https://www.linkedin.com/in/matthewaisthorpe/">
									View my career on LinkedIn
									<Icon icon="arrow-right" size="1.1em" />
								</CallToAction>
							</div>
						</div>
					</section>
				</div>

				<aside class="sidebar support-sidebar" aria-label="Qualifications and supporting background">
					<section class="card info-section">
						<h2 class="section-title">Education and qualifications</h2>
						<div class="content">
							<ul>
								<li><strong>SAE Institute Australia:</strong> Bachelor of Creative Media, Major in Interactive Media</li>
								<li><strong>Professional Scrum Master I (PSM I)</strong>, Scrum.org</li>
								<li><strong>Professional Scrum Product Owner I (PSPO I)</strong>, Scrum.org</li>
								<li><strong>AgileSHIFT – Enterprise Agility</strong>, PeopleCert</li>
								<li><strong>Microsoft AI Product Manager Professional Certificate</strong>, Microsoft / Coursera</li>
								<li><strong>Introduction to Artificial Intelligence</strong>, Institute of Applied Technology (IAT)</li>
							</ul>
						</div>
					</section>

					<section class="card info-section">
						<h2 class="section-title">Technical depth</h2>
						<div class="content">
							<p>My background in software development helps me work with teams to assess technical options and understand the trade-offs for scope, cost, delivery and ongoing support.</p>
						</div>
					</section>

					<section class="card info-section">
						<h2 class="section-title">Independent work and experiments</h2>
						<div class="content">
							<p>I founded <a href="https://fovrinteractive.net/">FoVR Interactive</a>, my independent studio for XR and immersive technology projects. Through that work, I was selected for Meta's Horizon Start Program and invited to Meta Connect 2025 as a Start Partner.</p>
							<p><a href="https://www.youtube.com/@beardydevadventures">Beardy Dev Adventures</a> is my personal devlog, where I share game development, XR and other hands-on experiments.</p>
						</div>
					</section>
				</aside>
			</div>
		</main>

		<ContactCTA heading="Let’s talk about product and delivery leadership." />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.about-grid {
		display: grid;
		gap: 1.5rem;
	}

	.about-grid > * {
		min-width: 0;
		width: 100%;
	}

	.main {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.card {
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.hero-image {
		display: block;
		width: min(70%, 960px);
		height: clamp(180px, 30vw, 320px);
		object-fit: cover;
		object-position: center top;
		margin: 1rem auto 0;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.info-section {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		color: var(--gray-200);
	}

	.lead-section {
		max-width: 100%;
	}

	.section-title {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.content {
		max-width: 70ch;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	.cta-row {
		display: flex;
	}

	.cta-row.start {
		justify-content: flex-start;
	}

	.cta-row.center {
		justify-content: center;
	}

	.cta-row.end {
		justify-content: flex-end;
	}

	.cta-small :global(a) {
		padding: 0.65rem 1.25rem;
		gap: 0.5rem;
		font-size: var(--text-md);
	}

	.content ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.content ul li {
		position: relative;
		padding: 0.25rem 0.25rem 0.25rem 1.5rem;
		line-height: 1.6;
	}

	.content ul li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--accent-regular);
		box-shadow: 0 0 0 6px var(--accent-subtle-overlay);
	}

	.highlight-link {
		margin-top: 0.5rem;
		font-weight: 600;
	}

	.highlight-link a {
		color: var(--accent-text-over);
	}

	.sidebar .section-title {
		font-size: var(--text-lg);
		overflow-wrap: anywhere;
	}

	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		width: 100%;
	}

	.snapshot-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		background:
			radial-gradient(
				circle at 92% 8%,
				var(--surface-glow-accent),
				transparent 32%
			),
			radial-gradient(
				circle at 8% 0%,
				var(--surface-glow-primary),
				transparent 36%
			),
			var(--surface-panel);
		border-color: color-mix(
			in srgb,
			var(--brand-primary),
			var(--brand-border) 68%
		);
		box-shadow: var(--shadow-premium);
	}

	.snapshot-card::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			var(--brand-primary-soft),
			transparent 42%,
			var(--brand-accent-soft)
		);
		opacity: 0.5;
	}

	.snapshot-card > * {
		position: relative;
		z-index: 1;
	}

	.snapshot-card h2 {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.snapshot-copy {
		display: grid;
		gap: 0.75rem;
		color: var(--gray-200);
		font-size: var(--text-sm);
		line-height: 1.65;
	}

	.snapshot-tags {
		padding-top: 0.25rem;
	}

	.badge-panel h3 {
		font-size: var(--text-lg);
		color: var(--gray-0);
		margin-bottom: 0.5rem;
	}

	.badge-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		min-width: 0;
	}

	.badge-list :global(.pill) {
		max-width: 100%;
		white-space: normal;
	}

	.muted {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.about-grid {
			grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
			align-items: start;
		}

		.main {
			grid-column: 1;
			grid-row: 1;
		}

		.snapshot-sidebar {
			grid-column: 2;
			grid-row: 1;
			position: sticky;
			top: 2rem;
		}

		.support-sidebar {
			grid-column: 2;
			grid-row: 1;
		}

		.card {
			padding: 1.75rem;
		}

		.section-title {
			font-size: var(--text-xl);
		}
	}
</style>
